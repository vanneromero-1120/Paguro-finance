# =============================================================================
# Paguro Finance V1 - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local to configure your local or production environment.
# Never commit real secrets or production credentials to source control!
# =============================================================================

# =============================================================================
# 1. REQUIRED FOR CORE V1 (CLIENT SAFE - BROWSER VISIBLE)
# =============================================================================
# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous API Key (Protected by PostgreSQL Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Base URL of the deployed application (used for OAuth redirects and canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application Branding & Default Locale
NEXT_PUBLIC_APP_NAME="Paguro Finance"
NEXT_PUBLIC_DEFAULT_CURRENCY=COP
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Bogota

# =============================================================================
# 2. REQUIRED FOR CORE V1 (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# =============================================================================
# Supabase Service Role Key: Bypasses RLS. Used exclusively by server actions,
# administrative migrations, and internal system tasks.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-here

# Storage Bucket for Accounting Documents & Fiscal Proofs
SUPABASE_STORAGE_BUCKET_FINANCIAL_DOCS=financial-documents

# Optional: Direct PostgreSQL Connection Pooler URL for database CLI tools
# DATABASE_URL=postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# =============================================================================
# 3. OPTIONAL EXTERNAL INTEGRATIONS (SERVER ONLY)
# =============================================================================
# If left blank, these providers will cleanly display "NOT CONFIGURED" without crashing.

# --- A. Google Drive Accounting Document Ingestion ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback (or production URL)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- B. AI Financial & Tax Advisor ---
# Optional: Live LLM inference provider for natural language synthesis
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- C. Payment Gateways Normalization (Optional) ---
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook
WOMPI_PRIVATE_KEY=prv_prod_your_wompi_key
WOMPI_EVENTS_SECRET=your_wompi_events_secret

# --- D. Tax Notification Channels (Optional) ---
# Email notifications provider (e.g. Resend, SendGrid)
RESEND_API_KEY=re_your_resend_api_key
TAX_ALERTS_FROM_EMAIL=notificaciones@paguro.com

# Slack alerts webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXX
