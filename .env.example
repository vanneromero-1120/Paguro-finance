# =============================================================================
# Paguro Finance - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local to configure your local or production environment.
# Never commit real secrets or production service role keys to source control!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Client Configuration (Public / Browser Safe)
# -----------------------------------------------------------------------------
# Obtained from: Supabase Dashboard -> Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public Anonymous API Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# -----------------------------------------------------------------------------
# 2. Supabase Administrative Configuration (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# -----------------------------------------------------------------------------
# Obtained from: Supabase Dashboard -> Project Settings -> API -> service_role secret
# WARNING: The Service Role Key bypasses Row Level Security (RLS).
# It must ONLY be used for migrations, administrative workers, and trusted backend tasks.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-here

# Optional: Direct PostgreSQL Connection String for CLI migrations (Transaction / Session pooler)
# Obtained from: Supabase Dashboard -> Project Settings -> Database -> Connection string
# DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# -----------------------------------------------------------------------------
# 3. Application & Localization Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Paguro Finance"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=COP
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Bogota

# -----------------------------------------------------------------------------
# 4. Storage Bucket Configuration
# -----------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET_FINANCIAL_DOCS=financial-documents
